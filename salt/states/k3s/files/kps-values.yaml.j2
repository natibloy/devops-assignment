{%- set monitoring = pillar['monitoring'] %}
{%- set secrets = pillar['secrets'] %}
{%- set nodes = pillar['network']['nodes'] %}
{%- set exporter_port = monitoring.node_exporter.port %}
{%- set grafana = monitoring.grafana %}
# Rendered by Salt from salt/states/k3s/files/kps-values.yaml.j2 - do not edit.

# No alertmanager: nothing in this assignment routes alerts, and leaving it out
# keeps the stack inside the compute node's memory budget.
alertmanager:
  enabled: false

grafana:
  adminUser: {{ secrets.grafana_admin_user }}
  adminPassword: {{ secrets.grafana_admin_password }}

  ingress:
    enabled: true
    ingressClassName: traefik
    hosts:
      - {{ grafana.host }}
    tls:
      - secretName: {{ grafana.tls_secret }}
        hosts:
          - {{ grafana.host }}

  # The sidecar picks up any ConfigMap labelled grafana_dashboard, which is how
  # the metrics-gateway chart ships the Phase 5 dashboard.
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: ALL

  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: default
          orgId: 1
          folder: ""
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/default

  dashboards:
    default:
      node-exporter-full:
        gnetId: {{ grafana.node_exporter_dashboard.gnet_id }}
        revision: {{ grafana.node_exporter_dashboard.revision }}
        datasource: Prometheus

prometheus:
  prometheusSpec:
    retention: {{ monitoring.kube_prometheus_stack.retention }}
    scrapeInterval: 15s
    resources:
      requests:
        memory: 512Mi
        cpu: 100m
      limits:
        memory: 1500Mi

    # Exporters the Prometheus Operator cannot discover on its own, because they
    # run outside the cluster. The controller's node_exporter is a Podman
    # container on a machine that is not a Kubernetes node, so no ServiceMonitor
    # can select it - which is exactly what additionalScrapeConfigs is for.
    #
    # The compute node's exporter is not listed here: it is the chart's own
    # DaemonSet, in-cluster and already scraped by the ServiceMonitor that ships
    # with it. Labels are left to Prometheus so both targets are labelled the
    # same way.
    #
    # Derived from the node map rather than hardcoded, so a second out-of-cluster
    # node would be picked up by adding it to the pillar.
    additionalScrapeConfigs:
      - job_name: node-exporter-external
        static_configs:
{%- for name, node in nodes.items() if node.role == 'controller' %}
          - targets:
              - '{{ node.ip }}:{{ exporter_port }}'
{%- endfor %}

# Runs node_exporter on the compute node, scraped by the ServiceMonitor the chart
# ships with - left at its defaults deliberately. The Podman-managed exporter that
# the assignment asks for stays exclusive to the controller, and is scraped through
# additionalScrapeConfigs above because nothing in Kubernetes can discover it.
#
# Because the DaemonSet runs with hostNetwork, its pod address is the node's own
# address, so both targets end up scraped at <node ip>:9100.
nodeExporter:
  enabled: true

# The kubelet/etcd/scheduler/controller-manager endpoints a single-node K3s server
# does not expose on the expected ports, so their targets never go stale-red.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false
kubeProxy:
  enabled: false
