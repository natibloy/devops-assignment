{#- The accounting daemon runs on whichever node holds the controller role, so
    the host is selected by role rather than named literally. -#}
{%- set slurm = pillar['slurm'] %}
{%- set nodes = pillar['network']['nodes'] %}
{%- set controller_name = ((nodes | dictsort | selectattr('1.role', 'equalto', 'controller') | list) | first)[0] %}
AuthType=auth/munge
DbdHost={{ controller_name }}
DbdPort={{ slurm.slurmdbd_port }}
SlurmUser={{ slurm.user.name }}

DebugLevel=info
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurmdbd.pid

StorageType=accounting_storage/mysql
StorageHost={{ slurm.db.host }}
StorageUser={{ slurm.db.user }}
StoragePass={{ pillar['secrets']['slurmdbd_db_password'] }}
StorageLoc={{ slurm.db.name }}
