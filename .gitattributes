# Guests are Linux; CRLF in any of these would break shell/Salt/YAML parsing.
* text=auto eol=lf

*.sh      text eol=lf
*.sls     text eol=lf
*.j2      text eol=lf
*.conf    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.sbatch  text eol=lf
Vagrantfile   text eol=lf
Containerfile text eol=lf

*.deb  binary
*.tar  binary
*.bz2  binary
*.gz   binary
